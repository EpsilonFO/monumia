# Configuration du site vitrine (Vite, port 3001). Copier en `.env` si besoin.
# Les trois variables ont un défaut de production dans le code : en local, ce
# fichier ne sert qu'à renvoyer vers l'application et l'API locales.

# Backend FastAPI, pour le formulaire d'inscription à la liste d'attente.
# Défaut du code : https://app.monumia.fr/api
VITE_API_URL=http://localhost:8000

# Application, cible des boutons « Se connecter » / « Commencer ».
# Défaut du code : https://app.monumia.fr
VITE_APP_URL=http://localhost:3000

# Préfixe d'URL du build, quand le site est servi sous un sous-chemin
# (beta.monumia.fr/landing). Vide ou absent en local.
VITE_BASE=/
