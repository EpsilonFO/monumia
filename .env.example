# Build args lus par docker-compose.yml, à la racine du dépôt : copier en `.env`.
#
# Uniquement pour les déploiements (VPS prod + beta). Ces valeurs sont injectées
# dans le build du frontend, qui n'a pas de variables d'environnement à
# l'exécution — d'où un couple URL/clé par cible.
#
# Pour développer en local, ce fichier ne sert à rien : voir README.md, et
# ./scripts/setup-env-local.sh qui génère backend/.env.local et
# frontend/.env.local. La configuration du backend est décrite dans
# backend/.env.example.

# Production (app.monumia.fr) — même projet Supabase que backend/.env
APP_SUPABASE_URL=https://YOUR_PROD_PROJECT.supabase.co
APP_SUPABASE_ANON_KEY=your_prod_anon_key

# Beta (beta.monumia.fr) — projet Supabase distinct, cf. backend/.env.beta
BETA_SUPABASE_URL=https://YOUR_BETA_PROJECT.supabase.co
BETA_SUPABASE_ANON_KEY=your_beta_anon_key

# Widget de retour Ybug (https://ybug.io) : l'identifiant du projet, visible
# dans le snippet d'installation du tableau de bord Ybug. Optionnel et vide par
# défaut — sans lui, aucun widget n'est chargé dans le build correspondant.
# Deux variables pour pouvoir n'ouvrir le bouton qu'en beta, ou envoyer les
# retours de la prod dans un autre projet Ybug.
APP_YBUG_ID=
BETA_YBUG_ID=

# Mesure d'audience anonyme PostHog : clé de projet `phc_…`. Vide = pas de
# mesure dans le build correspondant. Une clé par environnement, pour ne pas
# mêler les tests de la beta aux vrais utilisateurs (laisser BETA vide suffit).
APP_POSTHOG_KEY=
BETA_POSTHOG_KEY=
