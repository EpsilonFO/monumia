# Docker-compose build args for frontend Supabase configuration
# Copy this to .env and fill in the values

# Production (app.patrys.fr) — same Supabase project as backend/.env
APP_SUPABASE_URL=https://YOUR_PROD_PROJECT.supabase.co
APP_SUPABASE_ANON_KEY=your_prod_anon_key

# Beta (beta.patrys.fr) — separate Supabase project matching backend/.env.beta
BETA_SUPABASE_URL=https://YOUR_BETA_PROJECT.supabase.co
BETA_SUPABASE_ANON_KEY=your_beta_anon_key
