# Configuration du backend FastAPI. Copier en `.env` et renseigner les valeurs.
#
# EN DÉVELOPPEMENT LOCAL, ce fichier n'est pas nécessaire :
# `./scripts/setup-env-local.sh` génère `backend/.env.local` (chargé en priorité
# sur `.env`) à partir des clés de la stack Supabase locale.
#
# Ce modèle sert donc surtout à documenter ce qu'attend un déploiement, et à
# pointer une instance Supabase distante depuis un poste de dev.

# ─── Supabase (obligatoire) ───────────────────────────────────────────────────
# Dashboard → Project Settings → API. `SECRET_KEY` remplace l'ancienne clé
# service_role : elle contourne les RLS, ne jamais l'exposer côté navigateur.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Même rôle que SUPABASE_SECRET_KEY, sous le nom hérité qu'attendent encore les
# scripts de peuplement (backend/scripts/seeds/*.py).
SUPABASE_SERVICE_KEY=

# Secret HS256 du projet (Settings → API → JWT Secret). Optionnel : utile
# seulement si le projet signe encore en symétrique — les projets récents
# signent en ES256/RS256 et le JWKS suffit. Sans lui, un projet en HS256
# revalide chaque token auprès de l'API Auth (110-210 ms par requête).
SUPABASE_JWT_SECRET=

# ─── Comportement de l'application ───────────────────────────────────────────
# `development` expose /docs et /redoc ; toute autre valeur les désactive.
ENV=production
# `false` retire l'attribut Secure du cookie de refresh — indispensable en http.
COOKIE_SECURE=true
LOG_LEVEL=INFO
# Replis quand la requête ne permet pas de déduire l'origine (cf. config.py).
APP_URL=https://app.monumia.fr
FRONTEND_URL=https://app.monumia.fr

# ─── Emails d'invitation (projets partagés) ──────────────────────────────────
# Sans RESEND_API_KEY, les emails sont écrits dans la console : suffisant pour
# développer sans compte Resend.
RESEND_API_KEY=
RESEND_FROM="Monumia <invitations@monumia.fr>"

# ─── Stripe (accès payant aux aides) ─────────────────────────────────────────
# Sans STRIPE_SECRET_KEY, la facturation est simplement désactivée.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_DOSSIER=
STRIPE_PRICE_ABONNEMENT=
STRIPE_AUTOMATIC_TAX=false

# ─── Outils hors ligne uniquement ────────────────────────────────────────────
# Le diagnostic servi au produit est déterministe et n'appelle aucun LLM. Ces
# clés ne servent qu'à l'ingestion d'aides (/ingest-aide) et à la veille
# (scripts/veille_*.py) ; chaque modèle n'utilise que la sienne.
DEEPSEEK_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
MOONSHOT_API_KEY=
# scripts/sync_aides_territoires.py, scripts/backfill_aides_geo.py
AIDES_TERRITOIRES_API_TOKEN=
