# Configuration du backend FastAPI. Copier en `.env` et renseigner les valeurs.
#
# EN DÉVELOPPEMENT LOCAL, ce fichier n'est pas nécessaire :
# `./scripts/setup-env-local.sh` génère `backend/.env.local` (chargé en priorité
# sur `.env`) à partir des clés de la stack Supabase locale.
#
# Ce modèle sert donc surtout à documenter ce qu'attend un déploiement, et à
# pointer une instance Supabase distante depuis un poste de dev.

# ─── Supabase (obligatoire) ───────────────────────────────────────────────────
# Dashboard → Project Settings → API. `SECRET_KEY` remplace l'ancienne clé
# service_role : elle contourne les RLS, ne jamais l'exposer côté navigateur.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Même rôle que SUPABASE_SECRET_KEY, sous le nom hérité qu'attendent encore les
# scripts de peuplement (backend/scripts/seeds/*.py).
SUPABASE_SERVICE_KEY=

# Secret HS256 du projet (Settings → API → JWT Secret). Optionnel : utile
# seulement si le projet signe encore en symétrique — les projets récents
# signent en ES256/RS256 et le JWKS suffit. Sans lui, un projet en HS256
# revalide chaque token auprès de l'API Auth (110-210 ms par requête).
SUPABASE_JWT_SECRET=

# ─── Comportement de l'application ───────────────────────────────────────────
# `development` expose /docs et /redoc ; toute autre valeur les désactive.
ENV=production
# `false` retire l'attribut Secure du cookie de refresh — indispensable en http.
COOKIE_SECURE=true
LOG_LEVEL=INFO
# Replis quand la requête ne permet pas de déduire l'origine (cf. config.py).
APP_URL=https://app.monumia.fr
FRONTEND_URL=https://app.monumia.fr

# ─── Emails d'invitation (projets partagés) ──────────────────────────────────
# Sans RESEND_API_KEY, les emails partent au Mailpit du Supabase local
# (http://localhost:54324) si SMTP_DEV est posée, sinon dans la console.
RESEND_API_KEY=
RESEND_FROM="Monumia <invitations@monumia.fr>"
SMTP_DEV=localhost:54325
# Expéditeur des rappels automatiques (échéances, ouvertures de guichet), séparé
# des invitations : un filtre ou un désabonnement sur l'un ne doit pas couper
# l'autre.
RESEND_FROM_RAPPELS="Monumia <rappels@monumia.fr>"
# Avis à l'équipe à chaque compte créé (réponse directe à l'inscrit). Vide =
# aucun avis : à ne renseigner qu'en production, sinon chaque compte de test
# d'un poste de dev ou de la bêta arrive dans la boîte de contact.
NOTIF_INSCRIPTION_TO=
RESEND_FROM_NOTIFS="Monumia <notifications@monumia.fr>"

# ─── Stripe (offres Veille et Multi-monuments) ───────────────────────────────
# Sans STRIPE_SECRET_KEY, la facturation est simplement désactivée.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Les deux offres se négocient : aucun prix n'est affiché ni vendu en ligne.
# Ces variables sont donc OPTIONNELLES, et servent au seul webhook — reconnaître
# l'offre d'un abonnement créé dans le dashboard Stripe. Un prix négocié client
# par client n'y figure pas : on renseigne alors `subscriptions.plan` à la main.
STRIPE_PRICE_VEILLE=
STRIPE_PRICE_MULTI_MONUMENTS=
STRIPE_AUTOMATIC_TAX=false

# ─── Outils hors ligne uniquement ────────────────────────────────────────────
# Le diagnostic servi au produit est déterministe et n'appelle aucun LLM. Ces
# clés ne servent qu'à l'ingestion d'aides (/ingest-aide) et à la veille
# (scripts/veille_*.py) ; chaque modèle n'utilise que la sienne, et seule
# celle du modèle choisi est nécessaire.

# LE seul endroit où se règle le modèle de toute la veille (étage C, audit,
# typage). Alias du registre — `uv run python scripts/veille_llm.py` les liste
# — ou `fournisseur:identifiant` pour un modèle trop récent pour y figurer
# (ex. VEILLE_MODEL=glm:glm-5.4-flash). Vide = le défaut du dépôt.
# OpenRouter est une passerelle : une seule clé pour les modèles des autres
# éditeurs, avec un identifiant préfixé (VEILLE_MODEL=openrouter:z-ai/glm-4.6).
VEILLE_MODEL=

# Le pipeline de prospection/ingestion (scripts/prospecter.py, scripts/ingerer.py)
# règle son modèle PAR MÉTIER : trier trois cents URL au kilo ne demande pas le
# modèle qui typera une condition d'éligibilité. Résolution providall :
# argument de ligne de commande > LLM_MODEL_<ROLE> > LLM_MODEL.
# Avec plusieurs clés API renseignées, un rôle laissé vide NE PEUT PAS être
# résolu (providall refuse de choisir) : poser LLM_MODEL comme filet.
LLM_MODEL=
LLM_MODEL_TRI=            # classer des URL en lot
LLM_MODEL_LECTURE=        # qualifier une fiche
LLM_MODEL_DECOUVERTE=     # trouver la rubrique « aides » d'un site inconnu
LLM_MODEL_INGESTION=      # écrire le YAML d'une aide
LLM_MODEL_VERIFICATION=   # le réfuter (vérification adversariale)
# Relire l'ontologie en fin de run : un seul appel, qui juge des paires de faits
# déjà appariées par un pré-filtre déterministe. Un modèle bon marché suffit.
# Non renseigné, l'audit se rend en mode dégradé — il ne fait jamais échouer un
# run, et `ingerer.py --sans-audit` le coupe franchement.
LLM_MODEL_AUDIT=
LLM_MODEL_REDACTION=      # rédiger le bloc `fiche:` d'une aide (rediger_fiches.py)

# Une clé par fournisseur, dans l'ordre du registre.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
XAI_API_KEY=
MOONSHOT_API_KEY=
ZAI_API_KEY=
MISTRAL_API_KEY=
DEEPSEEK_API_KEY=
OPENROUTER_API_KEY=
# scripts/sync_aides_territoires.py, scripts/backfill_aides_geo.py
AIDES_TERRITOIRES_API_TOKEN=

# ─── Administration du catalogue (page /admin) ───────────────────────────────
# UUID Supabase des comptes autorisés à retirer une aide du catalogue et à
# reformuler les questions du QCM, séparés par des virgules. Propre à chaque
# environnement (prod et beta ont chacun leur projet Supabase, donc des
# identifiants différents pour les mêmes personnes). Vide = aucun administrateur.
ADMIN_USER_IDS=
