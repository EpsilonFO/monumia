# Configuration de la SPA (Vite). Copier en `.env` et renseigner les valeurs.
#
# EN DÉVELOPPEMENT LOCAL, ce fichier n'est pas nécessaire :
# `./scripts/setup-env-local.sh` génère `frontend/.env.local` (chargé en priorité
# sur `.env`) à partir des clés de la stack Supabase locale.
#
# Rappel Vite : seules les variables préfixées VITE_ sont exposées, et elles
# atterrissent dans le bundle servi au navigateur. N'y mettre que du public —
# jamais la clé secrète Supabase.

# URL du backend FastAPI. Défaut du code si absente : http://localhost:8000
VITE_API_URL=http://localhost:8000

# Obligatoires : sans elles, src/lib/supabase.ts lève une erreur au démarrage.
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=

# Site vitrine, vers lequel renvoie la déconnexion. Optionnel.
VITE_LANDING_URL=http://localhost:3001

# Widget de retour Ybug (https://ybug.io) : identifiant du projet, lu dans le
# snippet d'installation du tableau de bord Ybug. Optionnel — sans lui, aucun
# script n'est chargé et aucun bouton ne s'affiche. En déploiement, la valeur
# vient de APP_YBUG_ID / BETA_YBUG_ID (cf. .env.example à la racine).
VITE_YBUG_ID=

# Mesure d'audience anonyme PostHog (instance UE) : clé du projet, qui commence
# par `phc_` (Settings > Project > Project API key). Publique par nature, elle
# ne sert qu'à envoyer. Optionnelle : sans elle, PostHog n'est même pas chargé.
# En déploiement, la valeur vient de APP_POSTHOG_KEY / BETA_POSTHOG_KEY.
VITE_POSTHOG_KEY=
