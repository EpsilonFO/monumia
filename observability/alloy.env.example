# Identifiants Grafana Cloud Loki.
#
# Copier en `alloy.env` (gitignoré) et remplir avec les valeurs du dashboard.
#
# OÙ LES TROUVER
# --------------
# grafana.com → ton organisation → la pile (stack) → carte « Loki » → « Send Logs ».
# La page affiche les trois valeurs :
#
#   LOKI_URL       l'URL de push, elle DOIT se terminer par /loki/api/v1/push
#   LOKI_USERNAME  un identifiant numérique, souvent appelé « User » ou « Instance ID »
#   LOKI_TOKEN     un token à générer, commence par glc_
#
# Pour le token, choisis un périmètre d'écriture sur les logs uniquement.
# Un token d'administration n'a aucune raison de se trouver ici.

LOKI_URL=https://logs-prod-xxx.grafana.net/loki/api/v1/push
LOKI_USERNAME=000000
LOKI_TOKEN=glc_xxxxxxxxxxxxxxxxxxxxxxxx
